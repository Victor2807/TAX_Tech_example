<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión (tokens de Supabase) no se respalda ni se transfiere a otro dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="taxtech_sesion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="taxtech_sesion.xml" />
    </device-transfer>
</data-extraction-rules>
