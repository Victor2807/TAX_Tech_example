<?xml version="1.0" encoding="utf-8"?>
<!--
  La API local de TAX Tech corre en HTTP en la máquina de desarrollo (127.0.0.1:3001).
  Solo se permite texto plano hacia ella:
  - 10.0.2.2: la máquina anfitriona vista desde el emulador de Android;
  - localhost / 127.0.0.1: un dispositivo físico con `adb reverse tcp:3001 tcp:3001`.
  Cualquier otro servidor debe usar HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
